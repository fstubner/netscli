{
  "name": "product-site-template",
  "description": "Reusable modular landing page + docs + changelog template for launching new products.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:changelog": "node ./scripts/changelog-dates.mjs",
    "check:content": "node ./scripts/check-content.mjs",
    "theme": "node ./scripts/theme.mjs",
    "check:structured-data": "node ./scripts/structured-data.mjs",
    "check:css": "node ./scripts/css-shadowing.mjs --max 0",
    "check:regions": "node ./scripts/css-regions.mjs",
    "css:equivalence": "node ./scripts/css-equivalence.mjs",
    "check:wordmark": "node ./scripts/wordmark-inset.mjs",
    "test:a11y": "npm run build && node ./scripts/a11y.mjs",
    "check:contrast": "node ./scripts/contrast-sweep.mjs",
    "check:header": "node ./scripts/header-controls.mjs",
    "check:lighthouse": "node ./scripts/lighthouse.mjs",
    "visual:record": "node ./scripts/visual-snapshot.mjs record",
    "visual:check": "node ./scripts/visual-snapshot.mjs check",
    "assets:terminal": "node ./scripts/terminal-image.mjs",
    "assets:install-scripts": "node ./scripts/copy-install-scripts.mjs",
    "assets:wordmark": "node ./scripts/wordmark.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/cli": "^4.13.0",
    "chromedriver": "^154.0.0",
    "lighthouse": "^13.5.0",
    "linkedom": "^0.18.13",
    "selenium-webdriver": "^4.49.0",
    "sharp": "^0.35.4",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.1"
  }
}
