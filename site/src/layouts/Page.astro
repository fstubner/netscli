---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogDescription?: string;
  includeFaqSchema?: boolean;
  bodyClass?: string;
}

const {
  title = site.meta.title,
  description = site.meta.description,
  canonicalPath = '/',
  ogDescription,
  includeFaqSchema = true,
  bodyClass,
} = Astro.props;
const { meta, analytics, faq, version } = site;
const canonicalUrl =
  canonicalPath === '/' ? meta.domain : `${meta.domain}${canonicalPath}`;

// Build the JSON-LD from the same `site` data source that the visible
// FAQ section reads from. Keeps them in lockstep — if the visible FAQ
// changes, the schema updates automatically.
const softwareApp = {
  '@type': 'SoftwareApplication',
  name: meta.siteName,
  url: meta.domain,
  downloadUrl: `${site.hero.sourceUrl}/releases/latest`,
  description: meta.description,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'NetworkingApplication',
  operatingSystem: 'Windows, macOS, Linux',
  softwareVersion: version,
  license: 'https://opensource.org/licenses/MIT',
  programmingLanguage: 'Rust',
  codeRepository: site.hero.sourceUrl,
  author: {
    '@type': 'Person',
    name: meta.author.name,
    url: meta.author.url,
  },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  screenshot: meta.ogImage,
};

const faqPage = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const graph = includeFaqSchema ? [softwareApp, faqPage] : [softwareApp];
const ldJson = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }, null, 2);

const ogDesc = ogDescription ?? meta.ogDescription ?? description;
const shouldLoadAnalytics = import.meta.env.PROD && Boolean(analytics.cloudflareToken);
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content={meta.themeColor} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={meta.author.name} />
<meta name="keywords" content={meta.keywords} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={ogDesc} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={meta.ogImage} />
<meta property="og:site_name" content={meta.siteName} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={ogDesc} />
<meta name="twitter:image" content={meta.ogImage} />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href={meta.faviconPath} />
<link rel="apple-touch-icon" href={meta.faviconPath} />

<!-- Preconnect hints for the only third-party origins this page hits.
     Shaves ~150-300ms off the first request to each by warming DNS +
     TLS in parallel with HTML parsing. -->
<link rel="preconnect" href="https://api.github.com" crossorigin />
{shouldLoadAnalytics && (
  <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />
)}

<!-- Structured data: SoftwareApplication + FAQPage. AI answer engines
     cite these directly; the visible FAQ section below mirrors them. -->
<script is:inline type="application/ld+json" set:html={ldJson} />

{shouldLoadAnalytics && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: analytics.cloudflareToken })}
  />
)}
</head>
<body class={bodyClass}>
  <a class="skip-link" href="#main">Skip to content</a>
  <slot />
  <script>
    import { initNavScrollShadow } from '../scripts/nav-scroll';
    initNavScrollShadow();
  </script>
</body>
</html>
