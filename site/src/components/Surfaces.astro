---
import { site } from '../data/site';
const { surfaces, copy } = site;
---
<section id="surfaces" class="surfaces-section">
  <div class="w">
    <div class="surfaces-intro">
      <h2>{copy.surfaces.heading}</h2>
      <p class="lead" set:html={copy.surfaces.leadHtml} />
    </div>

    <div class="surfaces">
      {surfaces.map((s) => (
        <div class={`surface${s.flip ? ' flip' : ''}`}>
          <div class="surface-text">
            <h3>{s.title}</h3>
            <p set:html={s.body} />
            {s.downloads && (
              <div class="surface-downloads">
                {s.downloads.map((d) => (
                  <a class="surface-download-btn" href={d.url} download>
                    <span class="dl-label">{d.label}</span>
                    {d.hint && <span class="dl-hint">{d.hint}</span>}
                  </a>
                ))}
              </div>
            )}
          </div>
          <div class="surface-visual">
            {s.image ? (
              <picture>
                {s.image.webp && <source type="image/webp" srcset={s.image.webp} />}
                <img
                  src={s.image.src}
                  alt={s.image.alt}
                  width={s.image.width}
                  height={s.image.height}
                  loading="lazy"
                />
              </picture>
            ) : s.codeHtml ? (
              <div class="codeblock has-copy" set:html={s.codeHtml} />
            ) : null}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
