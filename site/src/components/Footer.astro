---
import { site } from '../data/site';
const { meta, hero, builtWith } = site;
---
<footer>
  <div class="footer-inner">
    <div>© <span id="y"></span> {meta.author.name} · MIT</div>
    <div class="flinks">
      <a class="external-link" href={hero.sourceUrl}>GitHub</a>
      <a class="external-link" href={`${hero.sourceUrl}/releases`}>Releases</a>
      <a href="/docs/">Docs</a>
      <a href="/changelog/">Changelog</a>
    </div>
    {builtWith.length > 0 && (
      <div class="built-with">
        Built with
        {builtWith.map((b, i) => (
          <>
            {i === 0 ? ' ' : i === builtWith.length - 1 ? ', and ' : ', '}
            <a class="external-link" href={b.url}>{b.name}</a>
          </>
        ))}.
      </div>
    )}
  </div>
</footer>
