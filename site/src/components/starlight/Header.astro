---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const pathname = Astro.url.pathname;
type NavLink = {
  href: string;
  label: string;
  external?: boolean;
};

const siteLinks: NavLink[] = [
  { href: '/#surfaces', label: 'Features' },
  { href: '/#install', label: 'Install' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/docs/', label: 'Docs' },
  { href: '/changelog/', label: 'Changelog' },
];

const isActive = (href: string) => {
  if (href === '/docs/') return pathname.startsWith('/docs');
  if (href === '/changelog/') return pathname.startsWith('/changelog');
  return pathname.replace(/\/$/, '') === href.replace(/\/$/, '');
};
---

<div class="docs-topbar">
  <a class="docs-mark" href="/" aria-label="NetsCLI home">
    <img src="/assets/netscli-wordmark.png" alt="NetsCLI" width="160" height="32" />
  </a>

  <div class="docs-header-search print:hidden">
    {shouldRenderSearch && <Search />}
  </div>

  <nav class="docs-nav-links" aria-label="Site navigation">
    {
      siteLinks.map((link) => (
        <a
          href={link.href}
          class={link.external ? 'external-link' : undefined}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="docs-header-theme sl-hidden md:sl-flex print:hidden">
    <ThemeSelect />
  </div>

</div>

<script>
    import { initDocsHeader } from '../../scripts/docs-header';
    initDocsHeader();
  </script>

<style>
  @layer starlight.core {
    .docs-topbar {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 1rem;
      height: var(--sl-nav-height);
      min-height: var(--sl-nav-height);
      width: min(
        calc(100vw - (var(--netscli-docs-shell-gutter, 1.5rem) * 2)),
        var(--netscli-docs-frame-width, 1120px)
      );
      max-width: calc(100vw - 2rem);
      margin-inline: auto;
      padding-inline: 1.5rem;
      min-width: 0;
    }

    .docs-mark {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 0;
      text-decoration: none;
      min-width: 0;
      height: var(--sl-nav-height);
      margin: 0 auto 0 0;
      transform: translateX(-18px);
    }

    .docs-mark img {
      display: block;
      width: 160px;
      height: auto;
    }

    .docs-nav-links {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.15rem;
      min-width: 0;
      font-size: 0.8125rem;
      height: var(--sl-nav-height);
      line-height: 1;
    }

    .docs-nav-links a {
      display: inline-flex;
      align-items: center;
      height: var(--sl-nav-height);
      color: var(--sl-color-gray-2);
      text-decoration: none;
      white-space: nowrap;
      line-height: 1;
      border-bottom: 2px solid transparent;
      padding: 0;
    }

    .docs-nav-links a:hover,
    .docs-nav-links a[aria-current='page'] {
      color: var(--sl-color-white);
    }

    .docs-nav-links a[aria-current='page'] {
      border-bottom-color: #0aae7a;
    }

    .docs-header-search {
      flex: 0 1 10.5rem;
      width: 10.5rem;
      max-width: 10.5rem;
      min-width: 8.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      height: var(--sl-nav-height);
    }

    .docs-header-search :global(site-search),
    .docs-header-search :global(site-search button) {
      display: flex;
      align-items: center;
      height: 2.25rem;
      min-width: 0;
      max-width: 100%;
    }

    .docs-header-theme {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: var(--sl-nav-height);
      margin: 0;
    }

    .docs-header-theme :global(starlight-theme-select),
    .docs-header-theme :global(starlight-theme-select label) {
      display: inline-flex;
      align-items: center;
      height: 100%;
    }

    @media (max-width: 72rem) {
      .docs-topbar {
        gap: 0.45rem;
        width: 100%;
        max-width: 100%;
        justify-content: flex-start;
        margin-inline: 0;
        padding-inline: 1rem;
      }

      .docs-mark {
        margin-right: 0;
        transform: translateX(-10px);
      }

      .docs-nav-links {
        margin-left: auto;
        gap: 0.7rem;
        font-size: 0.76rem;
      }

      .docs-mark img {
        width: 132px;
      }

      .docs-header-search {
        flex: 0 0 auto;
        width: 2.5rem;
        max-width: 2.5rem;
        min-width: 2.5rem;
        display: flex;
        margin-left: auto;
      }

      .docs-header-search :global(site-search button) {
        width: 2.5rem;
        min-width: 2.5rem;
        height: 2.5rem;
        justify-content: center;
        padding: 0;
        overflow: hidden;
      }

      .docs-header-search :global(site-search button span:not(.sr-only)),
      .docs-header-search :global(site-search button kbd) {
        display: none !important;
      }

      .docs-header-theme {
        display: none !important;
      }
    }

    @media (max-width: 72rem) {
      .docs-nav-links {
        display: none;
      }
    }
  }
</style>
