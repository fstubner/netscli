---
import { site } from '../data/site';
import { hrefFor, isCurrent, navLinks } from '../data/site-content/nav';
const { branding } = site;
const pathname = Astro.url.pathname;
const onHome = pathname === '/';
---
<nav data-site-nav data-open="false">
  <div class="nav-inner">
    <a class="mark" href="/" aria-label="NetsCLI home">
      <img src={branding.wordmark} alt="" width="160" height="32" />
    </a>
    <button
      class="nav-menu-toggle"
      type="button"
      data-site-nav-toggle
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="site-nav-links"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="nlinks" id="site-nav-links" data-site-nav-links>
      {navLinks.map((link) => (
        <a
          href={hrefFor(link, pathname)}
          class={link.external ? 'external-link' : undefined}
          data-section={link.section}
          data-site-nav-link
          aria-current={isCurrent(link, pathname) ? 'page' : undefined}
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

{
  onHome && (
    <script>
      import { initActiveNav } from '../scripts/site-nav';
      initActiveNav();
    </script>
  )
}

<script>
  import { initMobileNav } from '../scripts/site-nav';
  initMobileNav();
</script>

<style is:global>
/* nav */
nav{
  position:sticky;top:0;z-index:10;
  background:rgba(17,17,17,.85);backdrop-filter:blur(12px);
  border-bottom:1px solid rgba(255,255,255,.06);
  box-shadow:none;
  transition:box-shadow 160ms ease,border-color 160ms ease;
}

body:not(.nav-scrolled) nav{
  box-shadow:none !important;
}

body:not(.nav-scrolled) nav::after{
  opacity:0 !important;
}

nav::after{
  content:"";
  position:absolute;
  left:0;right:0;bottom:-22px;
  height:22px;
  pointer-events:none;
  opacity:0;
  background:linear-gradient(180deg,rgba(0,0,0,.42),rgba(0,0,0,0));
  transition:opacity 160ms ease;
}
body.nav-scrolled nav{
  border-bottom-color:rgba(10,174,122,.12);
  box-shadow:
    0 12px 28px rgba(0,0,0,.28),
    0 1px 0 rgba(10,174,122,.08) !important;
}
body.nav-scrolled nav::after{
  opacity:1;
}
.nav-inner{
  /* Matches the docs top bar. Padding alone gave 12+32+12 plus the 1px
     border on <nav> = 57px against the docs' 60px, so the bar jumped every
     time you crossed between the landing page and the docs. The border is
     on the parent, hence the -1px. Still a min, so the mobile wrapped state
     grows past it as before. */
  min-height:calc(var(--netscli-nav-height) - 1px);
  max-width:var(--netscli-shell-width);margin:0 auto;padding:12px var(--netscli-shell-gutter);
  display:flex;align-items:center;justify-content:space-between;gap:18px;
  flex-wrap:wrap;
  position:relative;
}
.mark{
  display:inline-block;line-height:0;text-decoration:none;
  filter:brightness(1);transition:filter 200ms;
  transform:translateX(-10px);
}
.mark img{
  display:block;width:160px;height:auto;image-rendering:auto;
}
.mark:hover{filter:brightness(1)}
@media(max-width:600px){
  .mark img{width:132px}
}
.nav-menu-toggle{
  display:none;
  width:2.45rem;
  height:2.45rem;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  gap:4px;
  border:1px solid rgba(255,255,255,.1);
  border-radius:7px;
  color:#d7d7d7;
  background:rgba(255,255,255,.035);
  cursor:pointer;
}
.nav-menu-toggle span{
  width:15px;
  height:1.5px;
  border-radius:999px;
  background:currentColor;
}
.nav-menu-toggle:hover,
.nav-menu-toggle:focus-visible{
  color:#fff;
  border-color:rgba(10,174,122,.35);
  outline:none;
}
.nlinks{display:flex;gap:20px;font-size:.8125rem;flex-wrap:wrap;justify-content:flex-end}
.nlinks a{
  color:#b0b0b0;text-decoration:none;
  display:inline-flex;align-items:center;min-height:32px;
  border-bottom:2px solid transparent;
  height:calc(100% + 24px);
  margin-block:-12px;
}
.nlinks a:hover{color:#e5e5e5}
/* Both values, because two different things set this attribute here.
   Nav.astro marks a genuine current page with "page"; the scroll spy in
   scripts/site-nav.ts marks the section you are looking at with "location",
   which is the correct ARIA value for a position within a page. Only "page"
   was styled, so on the landing page -- where every nav link is an anchor
   and the spy is the only thing that fires -- the underline never appeared
   at all. The docs bar was unaffected, which is why the two looked
   inconsistent. */
.nlinks a[aria-current="page"],
.nlinks a[aria-current="location"]{
  color:#e5e5e5;
  border-bottom-color:#0aae7a;
}
.external-link{
  display:inline-flex;
  align-items:center;
  gap:.3em;
  text-decoration:none;
}
.external-link-label{min-width:0}
.external-link::after{
  content:"↗";
  flex:0 0 auto;
  color:#0aae7a;
  font-size:.92em;
  font-weight:700;
  line-height:1;
  opacity:.9;
  text-decoration:none;
}
.external-link:hover::after{
  color:#23d198;
  opacity:1;
}
@media(max-width:600px){
  .nav-inner{padding:10px 18px;gap:10px 16px}
  .nlinks{font-size:.8rem}
}
@media(max-width:900px){
  .nav-inner{flex-wrap:nowrap}
  .nav-menu-toggle{display:inline-flex}
  .nlinks{
    display:none;
    position:absolute;
    top:calc(100% + 8px);
    left:18px;
    right:18px;
    z-index:30;
    flex-direction:column;
    align-items:stretch;
    justify-content:flex-start;
    gap:2px;
    padding:8px;
    background:rgba(22,24,26,.98);
    border:1px solid rgba(255,255,255,.1);
    border-radius:8px;
    box-shadow:0 14px 34px rgba(0,0,0,.36);
    backdrop-filter:blur(12px);
  }
  nav[data-open='true'] .nlinks{display:flex}
  .nlinks a{
    min-height:40px;
    justify-content:flex-start;
    padding:0 10px;
    border-bottom:0;
    border-left:2px solid transparent;
    /* Undo the desktop full-height trick. The base rule sets
       `height:calc(100% + 24px)` with `margin-block:-12px` so a horizontal
       nav link fills the bar and puts its underline on the bar's bottom
       edge. In this column that negative margin pulls every link 12px into
       each neighbour: measured 40px-tall links sitting only 18px apart, so
       each one overlapped the next by 22px and the lower half of every menu
       item activated the item below it. */
    height:auto;
    margin-block:0;
  }
  .nlinks a:hover,
  .nlinks a[aria-current='page'],
  .nlinks a[aria-current='location']{
    border-left-color:#0aae7a;
    border-bottom-color:transparent;
    background:rgba(10,174,122,.1);
  }
}

</style>
