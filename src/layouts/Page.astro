---
import '../styles/global.css';
import { site } from '../data/site';

const { meta, analytics, faq, version, builtWith } = site;

// Build the JSON-LD from the same `site` data source that the visible
// FAQ section reads from. Keeps them in lockstep — if the visible FAQ
// changes, the schema updates automatically.
const softwareApp = {
  '@type': 'SoftwareApplication',
  name: meta.siteName,
  url: meta.domain,
  downloadUrl: `${site.hero.sourceUrl}/releases/latest`,
  description: meta.description,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'NetworkingApplication',
  operatingSystem: 'Windows, macOS, Linux',
  softwareVersion: version,
  license: 'https://opensource.org/licenses/MIT',
  programmingLanguage: 'Rust',
  codeRepository: site.hero.sourceUrl,
  author: {
    '@type': 'Person',
    name: meta.author.name,
    url: meta.author.url,
  },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  screenshot: meta.ogImage,
};

const faqPage = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const ldJson = JSON.stringify(
  { '@context': 'https://schema.org', '@graph': [softwareApp, faqPage] },
  null,
  2,
);

const ogDesc = meta.ogDescription ?? meta.description;
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content={meta.themeColor} />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<meta name="author" content={meta.author.name} />
<meta name="keywords" content={meta.keywords} />
<meta property="og:type" content="website" />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={ogDesc} />
<meta property="og:url" content={meta.domain} />
<meta property="og:image" content={meta.ogImage} />
<meta property="og:site_name" content={meta.siteName} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={ogDesc} />
<meta name="twitter:image" content={meta.ogImage} />
<link rel="canonical" href={meta.domain} />
<link rel="icon" type="image/svg+xml" href={meta.faviconPath} />
<link rel="apple-touch-icon" href={meta.faviconPath} />

<!-- Structured data: SoftwareApplication + FAQPage. AI answer engines
     cite these directly; the visible FAQ section below mirrors them. -->
<script type="application/ld+json" set:html={ldJson} />

{analytics.cloudflareToken && (
  <script
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: analytics.cloudflareToken })}
  />
)}
</head>
<body>
  <slot />
</body>
</html>
