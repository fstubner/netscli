---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

import { hrefFor, isCurrent, navGroupBreak, navLinks } from '../../data/site-content/nav';
import { branding, meta } from '../../data/site-content/meta';

const pathname = Astro.url.pathname;

/* See the note in components/Nav.astro. */
function linkClass(link: (typeof navLinks)[number], index: number): string | undefined {
  const parts: string[] = [];
  if (link.external) parts.push('external-link');
  if (index === navGroupBreak) parts.push('nav-group-start');
  return parts.length ? parts.join(' ') : undefined;
}
---

<div class="docs-topbar">
  <a class={`docs-mark${branding.wordmarkLight ? ' has-light' : ''}`} href="/" aria-label={`${meta.siteName} home`}>
    {/* fetchpriority, because on a docs page this image IS the Largest
        Contentful Paint. There is no hero here -- the wordmark is the largest
        thing painted, so it is on the critical path by default rather than by
        choice, and it is discovered late: it sits behind the inlined stylesheet
        in <head> and competes with nothing that announces itself as urgent.

        Cloudflare field data, 24h to 2026-09-15: this element is named as the
        LCP element at 5,415ms, against a 599ms P50 on the same day. The asset
        is 8.8 KB, so the five seconds are discovery and connection, not bytes
        -- which is exactly what this hint addresses and what shrinking the
        image would not.

        NOT set on the landing page's copy of the same wordmark
        (components/Nav.astro). There the hero screenshot is the LCP element and
        already carries fetchpriority="high"; raising the logo too would put two
        images at the front of the queue and demote the one that actually is the
        largest paint. */}
    <img
      class="mark-dark"
      src={branding.wordmark}
      alt={branding.wordmarkAlt}
      width="160"
      height="32"
      fetchpriority="high"
    />
    {/* The light-theme variant stays at the default priority. Exactly one of
        the pair is ever painted, CSS picks which, and marking both high would
        put two images at the front of the queue for the same reason the
        landing page's logo is left alone above. The dark mark takes the hint
        because dark is the default theme. */}
    {branding.wordmarkLight && (
      <img class="mark-light" src={branding.wordmarkLight} alt={branding.wordmarkAlt} width="160" height="32" />
    )}
  </a>

  <div class="docs-header-search print:hidden">
    {shouldRenderSearch && <Search />}
  </div>

  <nav class="docs-nav-links" aria-label="Site navigation">
    {
      navLinks.map((link, i) => (
        <a
          href={hrefFor(link, pathname)}
          class={linkClass(link, i)}
          aria-current={isCurrent(link, pathname)}
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="docs-header-theme sl-hidden md:sl-flex print:hidden">
    <ThemeSelect />
  </div>

</div>

<script>
  import { initDocsHeader } from '../../scripts/docs-header';
  import { initDocsSearchKeys, initDocsSearchResilience } from '../../scripts/docs-search-keys';
  initDocsHeader();
  initDocsSearchKeys();
  initDocsSearchResilience();
</script>

<style>
  @layer starlight.core {
    .docs-topbar {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 1rem;
      height: var(--sl-nav-height);
      min-height: var(--sl-nav-height);
      width: min(
        calc(100vw - (var(--ui-docs-shell-gutter, 1.5rem) * 2)),
        var(--ui-docs-frame-width, 1120px)
      );
      max-width: calc(100vw - 2rem);
      margin-inline: auto;
      padding-inline: 1.5rem;
      min-width: 0;
    }

    .docs-mark {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 0;
      text-decoration: none;
      min-width: 0;
      height: var(--sl-nav-height);
      /* Cancels the wordmark asset's own transparent left margin. This was a
         flat -18px against a 12.4px margin, so the docs logo hung 5.5px
         further left than the identical logo on the landing bar. See
         tokens.css. */
      transform: translateX(calc(var(--ui-mark-width) * var(--ui-mark-inset-ratio) * -1));
    }

    /* See the note in Nav.astro: two assets when the content names a light
       one, gated so a product shipping a single asset is unaffected. */
    /* img in the selector: `.docs-mark img` below is (0,1,1) and beats a bare
       class at (0,1,0), which rendered both wordmarks at once. */
    .docs-mark img.mark-light { display: none; }
    html[data-theme='light'] .docs-mark.has-light img.mark-dark { display: none; }
    html[data-theme='light'] .docs-mark.has-light img.mark-light { display: block; }

    .docs-mark img {
      display: block;
      width: var(--ui-mark-width);
      height: auto;
        /* Bound by the bar as well as by the width token. A wordmark whose
           aspect is taller than the template's sample drives the bar's height
           instead of fitting inside it, and the active link's underline then
           stops meeting the bar's bottom border -- measured 6.9px adrift with
           a 2.20 aspect asset. object-fit keeps the glyph undistorted; when
           the clamp bites, the inset above over-compensates by a fraction of
           a pixel, far below the wordmark guard's 0.5px tolerance. */
        max-height: calc(var(--ui-nav-height) - 1.25rem);
        object-fit: contain;
        object-position: left center;
      /* Same token as the landing bar's `.mark`, so both bars darken the
         wordmark by the same amount on a light page. See tokens.css. */
      filter: var(--ui-mark-filter);
    }

    /* The bar is two groups: identity on the left, then search, navigation
       and the theme control together on the right. The auto margin is the
       seam, and it sits on the search box because search is the first
       element of the right-hand group.
     *
     * Two earlier placements are worth not repeating. On the wordmark, the
     * whole gap landed immediately after it, and since search was the next
     * element search came to rest near the middle of the bar, reading as a
     * stray control belonging to neither side -- measured at a 1367px bar,
     * search at x=704, the centre to within a few pixels. On .docs-nav-links,
     * search stayed pinned beside the wordmark at the far left, a long way
     * from the navigation it belongs with.
     *
     * DOM order is unchanged: search still precedes the nav links, so it is
     * reachable by keyboard before six nav items rather than after them. */
    .docs-header-search {
      margin-inline-start: auto;
    }

    .docs-nav-links {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.15rem;
      min-width: 0;
      font-size: 0.8125rem;
      height: var(--sl-nav-height);
      line-height: 1;
    }

    .docs-nav-links a {
      display: inline-flex;
      align-items: center;
      height: var(--sl-nav-height);
      color: var(--sl-color-gray-2);
      text-decoration: none;
      white-space: nowrap;
      line-height: 1;
      border-bottom: 2px solid transparent;
      padding: 0;
    }

    .docs-nav-links a:hover,
    .docs-nav-links a[aria-current] {
      color: var(--sl-color-white);
    }

    /* Same separator as the landing bar -- see Nav.astro, including why it is
       a short centred pseudo-element rather than a border: these links are the
       full nav height, so a border ran floor to ceiling and split the bar.
     *
     * The space it sits in is a MARGIN, not padding. It was padding, and the
     * current-page underline is a border on this same box -- so on the docs
     * page, where the group-start link is also the current one, the underline
     * began 15px to the left of the word and read as misaligned. Margin puts
     * the gap outside the box the border draws around; the pseudo-element
     * sits in that margin, negatively inset. */
    .docs-nav-links a.nav-group-start {
      position: relative;
      margin-inline-start: 1.3rem;
    }

    .docs-nav-links a.nav-group-start::before {
      content: "";
      position: absolute;
      inset-inline-start: -0.65rem;
      top: 50%;
      width: 1px;
      height: 18px;
      margin-block-start: -9px;
      background: rgba(var(--ui-hairline-rgb), 0.28);
    }

    .docs-nav-links a[aria-current] {
      border-bottom-color: var(--ui-accent);
    }

    .docs-header-search {
      flex: 0 1 10.5rem;
      width: 10.5rem;
      max-width: 10.5rem;
      min-width: 8.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      height: var(--sl-nav-height);
    }

    .docs-header-search :global(site-search),
    .docs-header-search :global(site-search button) {
      display: flex;
      align-items: center;
      height: 2.25rem;
      min-width: 0;
      max-width: 100%;
    }

    .docs-header-theme {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: var(--sl-nav-height);
      margin: 0;
    }

    .docs-header-theme :global(starlight-theme-select) {
      display: inline-flex;
      align-items: center;
      height: 100%;
    }

    /* The label is the visible control -- bordered, rounded, tinted -- so it
       must size to its content, not to the header. `height: 100%` stretched
       it to the full 60px nav height, next to a 37.6px search button, which
       is what made the bordered box look oversized and misaligned. The
       wrapper above keeps 100% so the control stays vertically centred. */
    .docs-header-theme :global(starlight-theme-select label) {
      display: inline-flex;
      align-items: center;
      height: auto;
    }

    @media (max-width: 72rem) {
      .docs-topbar {
        gap: 0.85rem;
        width: min(100%, calc(100vw - 2rem));
        max-width: calc(100vw - 2rem);
        padding-inline: 1rem;
      }

      .docs-nav-links {
        gap: 0.75rem;
        font-size: 0.78rem;
      }

      .docs-header-search {
        flex-basis: 8.75rem;
        width: 8.75rem;
        max-width: 8.75rem;
        min-width: 7.75rem;
      }

    }

    /* Where the hamburger appears -- see the note on .docs-nav-links below.
       The theme control moves into the mobile menu's footer at this point
       (MobileMenuFooter.astro), so it is relocated rather than lost. */
    @media (max-width: 49.99rem) {
      .docs-header-theme {
        display: none !important;
      }
    }

    @media (max-width: 72rem) {
      .docs-topbar {
        gap: 0.75rem;
        justify-content: flex-start;
        margin-inline: 0 auto;
        padding-inline-start: 1.5rem;
      }

      .docs-mark {
        margin-right: 0;
      }

      .docs-nav-links {
        margin-left: auto;
        gap: 0.7rem;
        font-size: 0.76rem;
      }

      .docs-header-search {
        flex: 0 0 auto;
        width: 2.5rem;
        max-width: 2.5rem;
        min-width: 2.5rem;
        display: flex;
      }

    }

    /* Where the hamburger appears, which since Starlight 0.42 is 50rem.
     *
     * Two earlier numbers are worth not repeating. 72rem matched the
     * hamburger while this site styled Starlight's <starlight-menu-button>
     * to show up to that width. 0.42 replaced that element with a plain
     * popover button that Starlight hides from 50rem up, so the styling
     * stopped reaching anything, and between 50rem and 72rem the bar showed
     * neither these links nor a menu holding them: the only way to Features,
     * Install, FAQ or the changelog was the wordmark. 900px was the older
     * choice, to match the landing bar, and it put these links on screen
     * beside a hamburger listing the same links.
     *
     * The rule is the one both mistakes point at: exactly one navigation at
     * every width. The links go when the menu that lists them arrives.
     *
     * Nav.astro keeps its own 900px: the landing page has no sidebar and no
     * hamburger, so nothing there duplicates its links. */
    @media (max-width: 49.99rem) {
      .docs-nav-links {
        display: none;
      }
    }
  }
</style>
