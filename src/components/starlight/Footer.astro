---
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import { site } from '../../data/site';
import Feedback from '../Feedback.astro';

const { meta } = site;
const year = new Date().getFullYear();
---

<footer class="docs-footer">
  {/*
    Starlight renders LastUpdated and EditLink from its OWN footer. This file
    replaces that footer, so turning the two on in astro.config.mjs was
    necessary and not sufficient -- the flags were live and nothing appeared
    anywhere on the page, because the components they enable had no host.
    That is the cost of overriding a component rather than extending it: the
    override inherits responsibility for everything the original rendered.
  */}
  <Pagination />

  {/* One row under the Previous/Next cards: this page's metadata on the
      left, the copyright on the right. It used to be three blocks -- the
      metadata, then the landing footer's copyright, links and built-with
      line -- and in the docs' content column, far narrower than the landing
      page, that wrapped into four lines of small grey text. The links are
      all in the header on every docs page, so the footer dropped them and
      the built-with line; the landing footer keeps both. */}
  <Feedback on="docs" />

  <div class="docs-footer-row">
    <div class="docs-page-meta">
      <LastUpdated />
      <EditLink />
    </div>
    <div class="docs-copyright">&copy; {year} {meta.author.name} · MIT · <a href="/privacy/">Privacy</a></div>
  </div>
</footer>

<style>
  @layer starlight.core {
    .docs-footer {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      margin-top: 4rem;
      padding-top: 1.75rem;
      border-top: 1px solid var(--sl-color-hairline);
    }

    .docs-footer-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      width: 100%;
      max-width: 1060px;
      margin-inline: auto;
      padding-inline: 1.5rem;
      color: var(--sl-color-gray-3);
      font-size: 0.75rem;
    }

    .docs-page-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
    }

    .docs-page-meta:empty {
      display: none;
    }

    .docs-footer :global(.pagination-links) {
      width: 100%;
      max-width: 1060px;
      margin-inline: auto;
      padding-inline: 1.5rem;
    }

    .docs-footer a {
      color: var(--sl-color-gray-3);
      text-decoration: none;
    }

    .docs-footer a:hover {
      color: var(--sl-color-gray-1);
    }

  }
</style>
