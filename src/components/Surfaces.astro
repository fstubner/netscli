---
import { site } from '../data/site';
const { surfaces, copy } = site;
---
<section id="surfaces" class="surfaces-section">
  <div class="w">
    <div class="surfaces-intro">
      <h2>{copy.surfaces.heading}</h2>
      <p class="lead" set:html={copy.surfaces.leadHtml} />
    </div>

    <div class="surfaces">
      {surfaces.map((s) => (
        <div class={`surface${s.flip ? ' flip' : ''}`}>
          <div class="surface-text">
            <h3>{s.title}</h3>
            <p set:html={s.body} />
            {s.downloads && (
              <div class="surface-downloads">
                {s.downloads.map((d) => (
                  <a class="surface-download-btn" href={d.url} download>
                    <span class="dl-label">{d.label}</span>
                    {d.hint && <span class="dl-hint">{d.hint}</span>}
                  </a>
                ))}
              </div>
            )}
          </div>
          <div class="surface-visual">
            {s.image ? (
              <picture>
                {s.image.webp && <source type="image/webp" srcset={s.image.webp} />}
                <img
                  src={s.image.src}
                  alt={s.image.alt}
                  width={s.image.width}
                  height={s.image.height}
                  loading="lazy"
                />
              </picture>
            ) : s.codeHtml ? (
              <div class="codeblock has-copy" set:html={s.codeHtml} />
            ) : null}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
/* ─── SURFACE CARDS ─── */
.surfaces-section{
  background:#141718;
  border-block:1px solid rgba(255,255,255,.045);
}
.surfaces-section::before{
  content:none;
}
.surfaces-intro{
  max-width:720px;
  margin-bottom:84px;
}
.surfaces-intro .lead{
  max-width:690px;
  margin-bottom:0;
}
.surfaces{display:grid;gap:90px}
.surface{
  display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start;
}
/* Grid children default to min-width:auto (content-based), which lets a
   long <pre> codeblock force the grid wider than the viewport. Clamping
   to 0 lets the codeblock's own overflow-x:auto contain the overflow. */
.surface>*{min-width:0}
.surface.flip{direction:rtl}
.surface.flip>*{direction:ltr;min-width:0}
.surface-text{padding-top:0}
.surface-text h3{font-size:1.125rem;font-weight:700;color:#f5f5f5;margin:0 0 22px}
.surface-text p{font-size:.875rem;color:#a8a8a8;margin:0;line-height:1.6}
.surface-text code{font-size:.75rem}
.surface-visual picture{
  display:block;
  line-height:0;
}
.surface-visual img{
  display:block;
  width:100%;height:auto;border-radius:10px;
  border:1px solid rgba(255,255,255,.08);
  box-shadow:0 12px 40px rgba(0,0,0,.4);
}
.surface-visual img:focus-visible,
.bigshot img:focus-visible{
  outline:2px solid #1edcff;
  outline-offset:3px;
}
.surface-visual .codeblock{
  background:#0b0d0e;border:1px solid rgba(255,255,255,.08);
  border-radius:10px;padding:16px 58px 16px 20px;
  font-family:ui-monospace,"SF Mono",Menlo,monospace;
  font-size:.75rem;line-height:1.7;white-space:pre;overflow-x:auto;color:#ccc;
  box-shadow:0 12px 40px rgba(0,0,0,.4);
  position:relative;
}
@media(max-width:720px){
  .surface{grid-template-columns:1fr}
  .surface.flip{direction:ltr}
}

</style>
