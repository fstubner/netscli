---
import { site } from '../data/site';
const { branding, hero } = site;
const onHome = Astro.url.pathname === '/';
const pathname = Astro.url.pathname;
const homeAnchor = (id: string) => (onHome ? `#${id}` : `/#${id}`);
const links = [
  { href: homeAnchor('surfaces'), label: 'Features', active: false, section: 'surfaces' },
  { href: homeAnchor('install'), label: 'Install', active: false, section: 'install' },
  { href: homeAnchor('faq'), label: 'FAQ', active: false, section: 'faq' },
  { href: '/docs/', label: 'Docs', active: pathname.startsWith('/docs') },
  { href: '/changelog/', label: 'Changelog', active: pathname.startsWith('/changelog') },
  { href: hero.sourceUrl, label: 'GitHub', active: false, external: true },
];
---
<nav data-site-nav data-open="false">
  <div class="nav-inner">
    <a class="mark" href="/">
      <img src={branding.wordmark} alt="" width="160" height="32" />
    </a>
    <button
      class="nav-menu-toggle"
      type="button"
      data-site-nav-toggle
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="site-nav-links"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="nlinks" id="site-nav-links" data-site-nav-links>
      {links.map((link) => (
        <a
          href={link.href}
          class={link.external ? 'external-link' : undefined}
          data-section={link.section}
          data-site-nav-link
          aria-current={link.active ? 'page' : undefined}
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

{
  onHome && (
    <script>
      import { initActiveNav } from '../scripts/site-nav';
      initActiveNav();
    </script>
  )
}

<script>
  import { initMobileNav } from '../scripts/site-nav';
  initMobileNav();
</script>

<style is:global>
/* nav */
nav{
  position:sticky;top:0;z-index:10;
  background:rgba(17,17,17,.85);backdrop-filter:blur(12px);
  border-bottom:1px solid rgba(255,255,255,.06);
  box-shadow:none;
  transition:box-shadow 160ms ease,border-color 160ms ease;
}

body:not(.nav-scrolled) nav{
  box-shadow:none !important;
}

body:not(.nav-scrolled) nav::after{
  opacity:0 !important;
}

nav::after{
  content:"";
  position:absolute;
  left:0;right:0;bottom:-22px;
  height:22px;
  pointer-events:none;
  opacity:0;
  background:linear-gradient(180deg,rgba(0,0,0,.42),rgba(0,0,0,0));
  transition:opacity 160ms ease;
}
body.nav-scrolled nav{
  border-bottom-color:rgba(10,174,122,.12);
  box-shadow:
    0 12px 28px rgba(0,0,0,.28),
    0 1px 0 rgba(10,174,122,.08) !important;
}
body.nav-scrolled nav::after{
  opacity:1;
}
.nav-inner{
  max-width:var(--netscli-shell-width);margin:0 auto;padding:12px var(--netscli-shell-gutter);
  display:flex;align-items:center;justify-content:space-between;gap:18px;
  flex-wrap:wrap;
  position:relative;
}
.mark{
  display:inline-block;line-height:0;text-decoration:none;
  filter:brightness(1);transition:filter 200ms;
  transform:translateX(-10px);
}
.mark img{
  display:block;width:160px;height:auto;image-rendering:auto;
}
.mark:hover{filter:brightness(1)}
@media(max-width:600px){
  .mark img{width:132px}
}
.nav-menu-toggle{
  display:none;
  width:2.45rem;
  height:2.45rem;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  gap:4px;
  border:1px solid rgba(255,255,255,.1);
  border-radius:7px;
  color:#d7d7d7;
  background:rgba(255,255,255,.035);
  cursor:pointer;
}
.nav-menu-toggle span{
  width:15px;
  height:1.5px;
  border-radius:999px;
  background:currentColor;
}
.nav-menu-toggle:hover,
.nav-menu-toggle:focus-visible{
  color:#fff;
  border-color:rgba(10,174,122,.35);
  outline:none;
}
.nlinks{display:flex;gap:20px;font-size:.8125rem;flex-wrap:wrap;justify-content:flex-end}
.nlinks a{
  color:#b0b0b0;text-decoration:none;
  display:inline-flex;align-items:center;min-height:32px;
  border-bottom:2px solid transparent;
  height:calc(100% + 24px);
  margin-block:-12px;
}
.nlinks a:hover{color:#e5e5e5}
.nlinks a[aria-current="page"]{
  color:#e5e5e5;
  border-bottom-color:#0aae7a;
}
.external-link{
  display:inline-flex;
  align-items:center;
  gap:.3em;
  text-decoration:none;
}
.external-link-label{min-width:0}
.external-link::after{
  content:"↗";
  flex:0 0 auto;
  color:#0aae7a;
  font-size:.92em;
  font-weight:700;
  line-height:1;
  opacity:.9;
  text-decoration:none;
}
.external-link:hover::after{
  color:#23d198;
  opacity:1;
}
@media(max-width:600px){
  .nav-inner{padding:10px 18px;gap:10px 16px}
  .nlinks{font-size:.8rem}
}
@media(max-width:900px){
  .nav-inner{flex-wrap:nowrap}
  .nav-menu-toggle{display:inline-flex}
  .nlinks{
    display:none;
    position:absolute;
    top:calc(100% + 8px);
    left:18px;
    right:18px;
    z-index:30;
    flex-direction:column;
    align-items:stretch;
    justify-content:flex-start;
    gap:2px;
    padding:8px;
    background:rgba(22,24,26,.98);
    border:1px solid rgba(255,255,255,.1);
    border-radius:8px;
    box-shadow:0 14px 34px rgba(0,0,0,.36);
    backdrop-filter:blur(12px);
  }
  nav[data-open='true'] .nlinks{display:flex}
  .nlinks a{
    min-height:40px;
    justify-content:flex-start;
    padding:0 10px;
    border-bottom:0;
    border-left:2px solid transparent;
  }
  .nlinks a:hover,
  .nlinks a[aria-current='page']{
    border-left-color:#0aae7a;
    border-bottom-color:transparent;
    background:rgba(10,174,122,.1);
  }
}

</style>
