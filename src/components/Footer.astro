---
import { site } from '../data/site';
const { meta, hero, builtWith, modules, feedback, social } = site;
const feedbackRepo = feedback.repo ?? social.repo;
// Built at build time, the way the docs footer does it. A <span id="y">
// filled in by page script left the year blank wherever no script called
// initLandingPage or initChangelogPage -- the 404 page has neither.
const year = new Date().getFullYear();
---
<footer>
  <div class="footer-inner">
    <div>© {year} {meta.author.name} · MIT</div>
    <div class="flinks">
      <a class="external-link" href={hero.sourceUrl}>GitHub</a>
      <a class="external-link" href={`${hero.sourceUrl}/releases`}>Releases</a>
      {modules.docs && <a href="/docs/">Docs</a>}
      {modules.changelog && <a href="/changelog/">Changelog</a>}
      {modules.privacy && <a href="/privacy/">Privacy</a>}
      {feedback.enabled && (
        <a class="external-link" href={`https://github.com/${feedbackRepo}/issues`}>Feedback</a>
      )}
    </div>
    {builtWith.length > 0 && (
      <div class="built-with">
        Built with
        {builtWith.map((b, i) => (
          <>
            {i === 0 ? ' ' : i === builtWith.length - 1 ? ', and ' : ', '}
            <a class="external-link" href={b.url}>{b.name}</a>
          </>
        ))}.
      </div>
    )}
  </div>
</footer>

<style is:global>
footer{
  border-top:1px solid rgba(var(--ui-lift-rgb),.06);padding:0;
}
.footer-inner{
  max-width:1060px;margin:0 auto;padding:28px 24px;
  display:flex;justify-content:space-between;align-items:center;
  flex-wrap:wrap;gap:12px;font-size:.75rem;color:var(--ui-text-muted);
}
footer a{color:var(--ui-text-muted);text-decoration:none}
footer a:hover{color:var(--ui-text)}
.flinks{display:flex;gap:16px}
</style>
