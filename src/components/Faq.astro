---
import { site } from '../data/site';
const { faq } = site;
---
<section id="faq">
  <div class="w">
    <h2>FAQ</h2>
    <p class="lead">The questions people actually ask before installing.</p>

    <div class="faq">
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="answer" set:html={f.aHtml ?? f.a} />
        </details>
      ))}
    </div>
  </div>
</section>
