---
import {
  compareColumns,
  compareCopy,
  compareNoteHtml,
  compareRows,
} from '../data/site-content/compare';

const highlightIndex = compareColumns.findIndex((c) => c.highlight);
---

<section id="compare">
  <div class="w">
    <h2>{compareCopy.heading}</h2>
    {compareCopy.leadHtml && <p class="lead" set:html={compareCopy.leadHtml} />}

    <!-- Focusable because it scrolls: six columns do not fit a phone, and axe
         wants a scrollable region reachable by keyboard. A table of text has no
         focusable descendant of its own. -->
    <div class="compare-scroll" tabindex="0">
      <table class="compare-table">
        <thead>
          <tr>
            <th scope="col">Feature</th>
            {compareColumns.map((c, i) => (
              <th scope="col" class={`col${i === highlightIndex ? ' mine' : ''}`}>{c.name}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {compareRows.map((row) => (
            <tr>
              <th scope="row">{row.feature}</th>
              {row.cells.map((cell, i) => (
                <td class={`col${i === highlightIndex ? ' mine' : ''}${cell === '—' ? ' none' : ''}`}>
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="compare-note" set:html={compareNoteHtml} />
  </div>
</section>

<style is:global>
/* ─── COMPARISON MATRIX ─── */

/* Drawn the way Supabase and Linear draw one: hairlines, no boxes, no capsules,
   and the compared column marked by a tint and a single left rule rather than
   ruled on four sides. */
.compare-scroll{overflow-x:auto;margin-bottom:14px}
.compare-table{
  width:100%;
  border-collapse:collapse;
  font-size:.8125rem;
  min-width:44rem;
}

.compare-table th,
.compare-table td{
  text-align:left;
  padding:12px 18px 12px 0;
  border-bottom:1px solid rgba(var(--ui-hairline-rgb),.14);
  vertical-align:middle;
  white-space:nowrap;
}
.compare-table thead th{
  padding-bottom:10px;
  border-bottom:1px solid rgba(var(--ui-hairline-rgb),.26);
  font-size:.6875rem;font-weight:700;
  letter-spacing:.07em;text-transform:uppercase;
  color:var(--ui-text-muted);
}
.compare-table tbody tr:last-child th,
.compare-table tbody tr:last-child td{border-bottom:0}

/* The feature column carries the row's name and is the only wrapping cell. */
.compare-table tbody th{
  font-weight:400;
  color:var(--ui-text);
  white-space:normal;
  padding-right:28px;
  min-width:15rem;
}

.compare-table th.col,
.compare-table td.col{
  padding-left:18px;
  border-left:1px solid rgba(var(--ui-hairline-rgb),.14);
  color:var(--ui-text);
}

/* A dash is an absence, so it recedes rather than competing with the answers. */
.compare-table td.none{color:var(--ui-text-muted)}

/* The tint composites to rgb(41,40,55) in the dark theme, where --ui-accent
   measures 4.30:1 and fails the contrast floor. Text in this column uses
   --ui-accent-bright instead: 8.83:1 dark, 8.23:1 light. */
.compare-table th.mine,
.compare-table td.mine{
  background:rgba(var(--ui-accent-rgb),.055);
  color:var(--ui-accent-bright);
  font-weight:600;
}
.compare-table thead th.mine{color:var(--ui-accent-bright)}
.compare-table td.mine.none{color:var(--ui-text-muted);font-weight:400}

/* The table's footnotes: as wide as the table they annotate. At 62ch they
   ran down the page under the first two columns, a narrow block of small
   print beside a wide table. Each <p> in the HTML is one note. */
.compare-note{
  font-size:.75rem;
  line-height:1.6;
  color:var(--ui-text-muted);
  margin:0;
}
.compare-note p{margin:0 0 4px}

@media(max-width:720px){
  .compare-table th,
  .compare-table td{padding:10px 12px 10px 0}
  .compare-table th.col,
  .compare-table td.col{padding-left:12px}
  .compare-table tbody th{min-width:12rem}
}
</style>
