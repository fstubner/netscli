---
import Page from '../layouts/Page.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Surfaces from '../components/Surfaces.astro';
import Install from '../components/Install.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
const githubRepo = site.social.repo;
---
<Page>
  <Nav />
  <main id="main" data-github-repo={githubRepo}>
    <Hero />
    <Surfaces />
    <Install />
    <Faq />
  </main>
  <Footer />

  <script>
    import { initLandingPage } from '../scripts/landing-page';
    const repo = document.querySelector<HTMLElement>('[data-github-repo]')?.dataset.githubRepo;
    if (repo) initLandingPage(repo);
  </script>
</Page>
