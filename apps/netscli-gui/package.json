{
  "name": "netscli-gui",
  "version": "0.3.0",
  "description": "NetsCLI GUI - Modern network scanner with beautiful desktop interface",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:pcap": "tauri dev --features pcap",
    "test:maintainability": "node ../../scripts/check-file-size.mjs",
    "test:tauri-render": "node e2e/tauri-render.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/selenium-webdriver": "^4.35.5",
    "@vitejs/plugin-react": "^6.0.1",
    "edgedriver": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "selenium-webdriver": "^4.44.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
