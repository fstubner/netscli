{
  "name": "netscli-gui",
  "version": "0.3.1",
  "description": "NetsCLI GUI - Modern network scanner with beautiful desktop interface",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:pcap": "tauri dev --features pcap",
    "test:maintainability": "node ../../scripts/check-file-size.mjs",
    "test:tauri-render": "node e2e/tauri-render.mjs",
    "test:tokens": "node ../../scripts/design-tokens.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/selenium-webdriver": "^4.35.5",
    "@vitejs/plugin-react": "^6.1.0",
    "edgedriver": "^6.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "selenium-webdriver": "^4.44.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
