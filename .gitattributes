# Content diverges from netscli on purpose: this repo carries sample content
# for a fictional product, netscli carries netscli's. Without this, every
# sync (see README, "Keeping it in sync") would conflict on each of these
# files as soon as netscli edited its own copy -- a conflict with nothing to
# decide, since the answer is always "keep ours".
#
# `merge=ours` needs the driver defined once per clone:
#
#   git config merge.ours.driver true
#
# Without it git falls back to a normal conflict, which is noisy but safe.
#
# Only files that are ENTIRELY content are listed. types.ts, nav.ts,
# modules.ts and site.ts hold shell code as well and must keep merging
# normally, or a sync would silently drop the code half.
src/data/site-content/changelog.ts  merge=ours
src/data/site-content/docs.ts       merge=ours
src/data/site-content/faq.ts        merge=ours
src/data/site-content/footer.ts     merge=ours
src/data/site-content/hero.ts       merge=ours
src/data/site-content/install.ts    merge=ours
src/data/site-content/install-clients.ts merge=ours
src/data/site-content/meta.ts       merge=ours
src/data/site-content/surfaces.ts   merge=ours
src/data/site-content/version.ts    merge=ours
src/content/docs/**                 merge=ours
public/assets/**                    merge=ours
public/favicon.svg                  merge=ours
CHANGELOG.md                        merge=ours
